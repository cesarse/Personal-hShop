{
  "sourceLanguage": "en",
  "strings": {
    "In FBI, choose Remote Install → Scan QR Code, then point the 3DS at a code below. Available at %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in FBI Remote Install → Scan QR Code und richten Sie den 3DS dann auf einen der Codes unten. Verfügbar unter %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En FBI, elige Remote Install → Scan QR Code y apunta la 3DS a uno de los códigos de abajo. Disponible en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans FBI, choisissez Remote Install → Scan QR Code, puis dirigez la 3DS vers l’un des codes ci-dessous. Disponible sur %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In FBI, scegli Remote Install → Scan QR Code, poi inquadra con il 3DS uno dei codici qui sotto. Disponibile su %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No FBI, escolha Remote Install → Scan QR Code e aponte o 3DS para um dos códigos abaixo. Disponível em %@."
          }
        }
      }
    },
    "Install the games shared from this Mac on your Nintendo 3DS: open FBI on the console, then scan the QR code of the game you want to install.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie die von diesem Mac freigegebenen Spiele auf Ihrem Nintendo 3DS: Starten Sie FBI auf der Konsole und scannen Sie den QR-Code des gewünschten Spiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala en tu Nintendo 3DS los juegos compartidos desde este Mac: abre FBI en la consola y escanea el código QR del juego que quieras instalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez sur votre Nintendo 3DS les jeux partagés depuis ce Mac : ouvrez FBI sur la console, puis scannez le code QR du jeu que vous voulez installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa sul tuo Nintendo 3DS i giochi condivisi da questo Mac: avvia FBI sulla console, poi scansiona il codice QR del gioco che vuoi installare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale no seu Nintendo 3DS os jogos compartilhados por este Mac: abra o FBI no console e escaneie o código QR do jogo que você quer instalar."
          }
        }
      }
    },
